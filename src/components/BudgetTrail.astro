---
import { budgetSections } from '../data/site'
---

<nav class="budget-trail" aria-label="Budget guide">
  {budgetSections.map((section) => (
    <div class="budget-trail-section">
      <p>{section.label}</p>
      <ol>
        {section.items.map((item) => (
          <li class:list={{ active: Astro.url.pathname === item.href }}>
            <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
              <span>{item.short}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ol>
    </div>
  ))}
</nav>
