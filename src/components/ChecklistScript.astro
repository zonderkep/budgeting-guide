<script>
  const storageKey = 'money-step-by-step-v2'
  const legacyStorageKey = 'budget-step-by-step-v1'
  const checklists = document.querySelectorAll<HTMLElement>('[data-checklist]')
  const resetButton = document.querySelector<HTMLButtonElement>('[data-reset-progress]')

  type ProgressState = Record<string, unknown> & { checklists?: Record<string, number[]> }

  const readState = (): ProgressState => {
    try {
      const current = JSON.parse(localStorage.getItem(storageKey) || '{}') as ProgressState
      if (current.checklists) return current

      const legacy = JSON.parse(localStorage.getItem(legacyStorageKey) || '{}') as Record<string, number[]>
      if (Object.keys(legacy).length === 0) return {}

      const migrated = { ...current, checklists: legacy }
      localStorage.setItem(storageKey, JSON.stringify(migrated))
      return migrated
    } catch {
      localStorage.removeItem(storageKey)
      return {}
    }
  }

  const state = readState()
  const checklistsState = state.checklists || {}

  checklists.forEach((list) => {
    const id = list.dataset.checklist
    if (!id) return

    const checked = checklistsState[id] || []
    list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((input) => {
      const index = Number(input.dataset.checkIndex)
      input.checked = checked.includes(index)
      input.addEventListener('change', () => {
        checklistsState[id] = Array.from(list.querySelectorAll<HTMLInputElement>('input:checked')).map((item) => Number(item.dataset.checkIndex))
        state.checklists = checklistsState
        localStorage.setItem(storageKey, JSON.stringify(state))
      })
    })
  })

  resetButton?.addEventListener('click', () => {
    Object.keys(checklistsState).forEach((key) => delete checklistsState[key])
    state.checklists = checklistsState
    localStorage.setItem(storageKey, JSON.stringify(state))
    checklists.forEach((list) => {
      list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((input) => {
        input.checked = false
      })
    })
    const originalText = resetButton.textContent
    resetButton.textContent = 'Progress reset'
    window.setTimeout(() => {
      resetButton.textContent = originalText
    }, 2000)
  })
</script>
