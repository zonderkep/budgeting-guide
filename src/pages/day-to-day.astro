---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import Checklist from '../components/Checklist.astro'
import ChecklistScript from '../components/ChecklistScript.astro'
import ActualMap from '../components/ActualMap.astro'
import Callout from '../components/Callout.astro'
import NextStep from '../components/NextStep.astro'

const reviewItems = [
  { text: 'Add recent transactions.', detail: 'Enter them by hand or import a QIF, OFX, QFX, CAMT, or CSV file from your bank.' },
  { text: 'Check the payee and amount.', detail: 'Compare unclear purchases with a receipt or order history.' },
  { text: 'Choose a category.', detail: 'Do not leave a transaction without a category.' },
  { text: 'Split mixed purchases.', detail: 'Use Split when one purchase belongs to more than one category.' },
  { text: 'Check pending transactions.', detail: 'A transaction can be correct before it clears. Check it again later.' },
]
---

<BaseLayout title="Day-to-day routine" description="Use a short routine to maintain an Actual Budget file.">
  <PageHero eyebrow="Routine · Use your budget" title="Keep the budget current." intro="Review transactions often. Small, regular checks are easier than one large cleanup." step={3} />
  <div class="content-shell">
    <section class="routine-panel" aria-labelledby="routine-heading">
      <div class="routine-time"><span>5</span><small>steps</small></div>
      <div><p class="eyebrow">Your regular check</p><h2 id="routine-heading">Process every transaction.</h2><Checklist id="daily-review" items={reviewItems} /></div>
    </section>

    <ActualMap view="transactions" />

    <section class="content-section" aria-labelledby="fund-heading">
      <div class="section-heading narrow"><p class="eyebrow">When new money arrives</p><h2 id="fund-heading">Fund categories in priority order.</h2><p>Use your current money priority after essentials and known costs are covered.</p></div>
      <ol class="priority-list">
        <li><span>First</span><div><h3>Protect essentials.</h3><p>Fund housing, food, utilities, transport, insurance, and required payments.</p></div></li>
        <li><span>Then</span><div><h3>Prepare for known costs.</h3><p>Add the planned monthly amount to annual bills and sinking funds.</p></div></li>
        <li><span>Next</span><div><h3>Fund the current priority.</h3><p>Use the money that remains for the safety, debt, retirement, or goal you are working toward. <a href="/money-priorities/">Choose a priority.</a></p></div></li>
        <li><span>Stop</span><div><h3>Leave To Budget at zero.</h3><p>Do not assign money that is not in an account yet.</p></div></li>
      </ol>
    </section>

    <Callout title="A cash withdrawal is still spending." tone="coral"><p>Assign the withdrawal to its intended category. Do not leave it in a general cash category.</p></Callout>
    <NextStep href="/month-close/" label="At the new month" title="Review and reconcile." text="Wait for late transactions. Then check the old month one last time." />
  </div>
  <ChecklistScript />
</BaseLayout>
