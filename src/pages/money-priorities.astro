---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import SpendingFlow from '../components/SpendingFlow.astro'
import StabilityCheck from '../components/StabilityCheck.astro'
import Callout from '../components/Callout.astro'
---

<BaseLayout title="Money priorities" description="Choose what your next available dollar should support after the budget is stable.">
  <PageHero eyebrow="The financial path · United States" title="Where should the next dollar go?" intro="Your budget creates stability. Use this path to choose the next priority for extra money." />

  <div class="flow-shell">
    <Callout title="Use this as general education." tone="yellow">
      <p>This path is for the United States. It is not personal financial, tax, or legal advice. Interest rates, tax limits, and account rules can change.</p>
    </Callout>

    <StabilityCheck />

    <SpendingFlow />

    <p class="flow-reference-link"><a class="text-link" href="/references/#priority-sources">See the original flowchart and supporting sources <span aria-hidden="true">→</span></a></p>
  </div>
</BaseLayout>
