---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
---

<BaseLayout title="References" description="Official guides and selected videos for Actual Budget and zero-based budgeting.">
  <PageHero eyebrow="Keep learning" title="Useful sources, without the noise." intro="Use the official Actual Budget guides first. The other links explain ideas that also work in Actual." />
  <div class="content-shell reference-content">
    <section class="reference-section" aria-labelledby="actual-links">
      <div class="reference-heading"><span class="source-mark actual-mark">A</span><div><p class="eyebrow">Start here</p><h2 id="actual-links">Actual Budget guides</h2></div></div>
      <div class="link-list">
        <a href="https://actualbudget.org/docs/getting-started/roadmap-for-new-users"><span><strong>Roadmap for new users</strong><small>The official order for learning Actual Budget.</small></span><b aria-hidden="true">↗</b></a>
        <a href="https://actualbudget.org/docs/getting-started/envelope-budgeting"><span><strong>How envelope budgeting works</strong><small>Why every available dollar gets a category.</small></span><b aria-hidden="true">↗</b></a>
        <a href="https://actualbudget.org/docs/transactions/importing"><span><strong>Import transactions</strong><small>Supported files and CSV field mapping.</small></span><b aria-hidden="true">↗</b></a>
        <a href="https://actualbudget.org/docs/accounts/reconciliation"><span><strong>Reconcile an account</strong><small>How to compare Actual with your bank.</small></span><b aria-hidden="true">↗</b></a>
      </div>
    </section>

    <section class="reference-section" aria-labelledby="method-links">
      <div class="reference-heading"><span class="source-mark method-mark">0</span><div><p class="eyebrow">The method</p><h2 id="method-links">Zero-based budgeting</h2></div></div>
      <div class="link-list">
        <a href="https://support.ynab.com/en_us/the-ynab-method-an-overview-SJmiqpi6j"><span><strong>The YNAB Method</strong><small>A clear explanation of jobs for dollars and true expenses.</small></span><b aria-hidden="true">↗</b></a>
        <a href="https://support.ynab.com/en_us/overspending-in-ynab-a-guide-ryWoxEyi"><span><strong>Handle overspending</strong><small>Why a negative category needs a decision.</small></span><b aria-hidden="true">↗</b></a>
        <a href="https://www.ramseysolutions.com/budgeting/how-to-budget"><span><strong>How to make a budget</strong><small>Ramsey Solutions guidance on priorities and zero-based planning.</small></span><b aria-hidden="true">↗</b></a>
        <a href="https://www.ramseysolutions.com/saving/stop-the-panic-sinking-fund"><span><strong>How sinking funds work</strong><small>Plan monthly for a known future cost.</small></span><b aria-hidden="true">↗</b></a>
      </div>
    </section>

    <section class="reference-section" aria-labelledby="video-links">
      <div class="reference-heading"><span class="source-mark video-mark" aria-hidden="true">▶</span><div><p class="eyebrow">Optional videos</p><h2 id="video-links">Watch a walkthrough</h2></div></div>
      <div class="video-grid">
        <a href="https://www.youtube.com/watch?v=LMVqJ10GXII"><span class="video-time">9 min</span><h3>Actual Budget Tutorial (2025)</h3><p>Digibase Media · A short tour of the main workflow.</p><b>Watch on YouTube ↗</b></a>
        <a href="https://www.youtube.com/watch?v=UMwyYIXEsz8"><span class="video-time">26 min</span><h3>Actual Budget: The Best Free Envelope Budgeting App (YNAB Alternative)</h3><p>Digital Lagoon · A recent, detailed beginner setup.</p><b>Watch on YouTube ↗</b></a>
      </div>
      <p class="source-note">Videos can become outdated. Use the official documentation when a screen or label is different.</p>
    </section>
  </div>
</BaseLayout>
